{
  "name": "acme",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "pnpm exec turbo dev",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "prepare": "husky"
  },
  "devDependencies": {
    "@next/playwright": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@repo/db": "workspace:*",
    "@types/node": "^26.4.0",
    "better-auth": "^1.7.2",
    "fallow": "^3.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-config-awesomeness": "^4.4.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "zod-compiler": "^1.28.0"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
