{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["PGAPPNAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "AUTH_ALLOWED_HOSTS",
        "BETTER_AUTH_SECRET",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "EXPOSE_TESTING_API",
        "NEXT_PUBLIC_WEB_APP_URL",
        "TRUSTED_ORIGINS",
        "WEB_APP_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "format:check": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:watch": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^db:generate", "db:generate"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "@repo/ui#test": {
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config-vitest/**",
        "$TURBO_ROOT$/packages/config-typescript/**",
        "$TURBO_ROOT$/tsconfig.json"
      ],
      "env": ["CI", "LANG", "LC_ALL", "NODE_ENV", "TZ"]
    }
  }
}
