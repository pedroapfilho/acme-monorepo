# API URL (for Better Auth client and any browser-side fetches)
NEXT_PUBLIC_API_URL=https://acme.api.localhost

# Database (for server-side session validation)
DATABASE_URL=postgresql://acme:acme123@localhost:5432/acme
PGAPPNAME=acme:local:web

# Better Auth (for server-side session validation). The base URL is derived
# from the request via Better Auth's dynamic baseURL (allowedHosts) rather
# than being configured directly.
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Optional: comma-separated extra hostnames Better Auth accepts when deriving
# that base URL. `**.localhost`, `**.localhost:*`, `localhost:*` and
# `127.0.0.1:*` are built in, so local dev needs nothing here; set the prod
# and preview domains in those environments.
AUTH_ALLOWED_HOSTS=

# Optional: comma-separated extra origins Better Auth trusts for CSRF checks and
# redirects, on top of the loopback ports and the default web/landing origins.
# For callers that are not browser CORS clients, such as another backend service.
TRUSTED_ORIGINS=

# Web origin: the Open Graph / Twitter card metadataBase and the base of the
# links in auth emails. Optional in dev, where portless fills it in; required
# whenever RESEND_API_KEY is set, since auth refuses to mail relative links.
WEB_APP_URL=https://acme.web.localhost

# Sender address for all transactional/auth mail. Required: there is no default,
# so the app can never mail from the wrong domain. Validation runs on the first
# auth request. A bare address without the display name is also accepted.
FROM_EMAIL="Acme <noreply@email.acme.com>"

# Optional: Resend API for email. Mail is skipped entirely when this is unset.
RESEND_API_KEY=
# Sends mail to the e2e Resend stub (tests/e2e/support/resend-stub.ts) instead of api.resend.com.
# RESEND_BASE_URL=http://127.0.0.1:3999
# Port the e2e Resend stub listens on; must match RESEND_BASE_URL.
# RESEND_STUB_PORT=3999
