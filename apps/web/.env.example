# API URL (for Better Auth client and any browser-side fetches)
NEXT_PUBLIC_API_URL=https://acme.api.localhost

# Database (for server-side session validation)
DATABASE_URL=postgresql://acme:acme123@localhost:5432/acme

# Better Auth (for server-side session validation). The base URL is derived
# from the request via Better Auth's dynamic baseURL (allowedHosts); set
# AUTH_ALLOWED_HOSTS for prod/preview domains beyond *.localhost.
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Web origin; used as the metadataBase for Open Graph / Twitter card
# image URL resolution. Optional in dev (falls back to acme.web.localhost).
WEB_APP_URL=https://acme.web.localhost

# Sender address for all transactional/auth mail. Required: there is no default,
# so the app can never mail from the wrong domain. Validation is lazy here (unlike
# apps/api, which parses at import): the web app boots and serves pages with this
# missing or malformed, then throws on the first request that touches auth. Set it
# before the app takes traffic. A bare address without the display name is
# also accepted.
FROM_EMAIL="Acme <noreply@email.acme.com>"

# Optional: Resend API for email. Mail is skipped entirely when this is unset.
RESEND_API_KEY=
