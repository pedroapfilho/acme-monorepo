# Web app origin the landing page links to for sign-in and registration.
# Optional: falls back to https://acme.web.localhost when unset. The
# NEXT_PUBLIC_ prefix means Next.js inlines the value into the client bundle at
# build time, so it has to be set for `next build`, not at runtime.
NEXT_PUBLIC_WEB_APP_URL=https://acme.web.localhost
