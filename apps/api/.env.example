# Database
DATABASE_URL=postgresql://acme:acme123@localhost:5432/acme

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Better Auth. The base URL is derived from the request via Better Auth's
# dynamic baseURL (allowedHosts) rather than being configured directly.
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Optional: comma-separated extra hostnames Better Auth accepts when deriving
# that base URL. `**.localhost`, `localhost:*` and `127.0.0.1:*` are built in,
# so local dev needs nothing here; set the prod and preview domains in those
# environments.
AUTH_ALLOWED_HOSTS=

# CORS
CORS_ORIGINS=https://acme.web.localhost,https://acme.landing.localhost

# Optional: comma-separated extra origins Better Auth trusts for CSRF checks and
# redirects, on top of the loopback ports and CORS_ORIGINS above. For callers
# that are not browser CORS clients, such as another backend service.
TRUSTED_ORIGINS=

# Sender address for all transactional/auth mail. Required: there is no default,
# so a missing or malformed value fails startup instead of mailing from the wrong
# domain. A bare address without the display name is also accepted.
FROM_EMAIL="Acme <noreply@email.acme.com>"

# Optional: Resend API for email. Mail is skipped entirely when this is unset.
RESEND_API_KEY=
