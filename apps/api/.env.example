# Database
DATABASE_URL=postgresql://acme:acme123@localhost:5432/acme
PGAPPNAME=acme:local:api

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Better Auth. The base URL is derived from the request via Better Auth's
# dynamic baseURL (allowedHosts) rather than being configured directly.
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# The web app's URL. An https value makes the session cookie Secure and
# __Secure--prefixed, matching the cookie the web app sets.
WEB_APP_URL=https://acme.web.localhost

# Optional: comma-separated extra hostnames Better Auth accepts when deriving
# that base URL. `**.localhost`, `**.localhost:*`, `localhost:*` and
# `127.0.0.1:*` are built in, so local dev needs nothing here; set the prod
# and preview domains in those environments.
AUTH_ALLOWED_HOSTS=

# Number of reverse proxies in front of the api that append the client address to
# X-Forwarded-For (1 for a single load balancer, 2 for a CDN in front of one).
# 0 keys rate limits on the socket address.
TRUSTED_PROXY_HOPS=0

# CORS
CORS_ORIGINS=https://acme.web.localhost,https://acme.landing.localhost

# Optional: comma-separated extra origins Better Auth trusts for CSRF checks and
# redirects, on top of the loopback ports and CORS_ORIGINS above. For callers
# that are not browser CORS clients, such as another backend service.
TRUSTED_ORIGINS=
